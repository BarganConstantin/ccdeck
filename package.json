{
  "name": "ccdeck",
  "version": "3.26.4",
  "description": "Live dashboard for Claude Code and Codex — which agent is waiting on you, tool calls, token spend and every Claude Code subagent on one calm canvas. Run it with npx ccdeck.",
  "type": "module",
  "bin": {
    "ccdeck": "bin/agent-dag.js"
  },
  "files": [
    "bin",
    "hook",
    "src/server",
    "dist/web",
    "release-notes.json",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSING.md"
  ],
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node src/server/index.mjs",
    "start": "node bin/agent-dag.js",
    "build": "vite build",
    "test": "vitest run",
    "prepublishOnly": "vite build",
    "prepack": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude-code-dashboard",
    "claude",
    "anthropic",
    "codex",
    "codex-cli",
    "openai",
    "agents",
    "ai-agents",
    "subagents",
    "dashboard",
    "monitor",
    "monitoring",
    "observability",
    "usage",
    "cost",
    "tokens",
    "quota",
    "hooks",
    "dag",
    "visualization",
    "cli",
    "deck"
  ],
  "author": "Bargan Constantin",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarganConstantin/ccdeck.git"
  },
  "bugs": {
    "url": "https://github.com/BarganConstantin/ccdeck/issues"
  },
  "homepage": "https://ccdeck.dev",
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dagre": "^0.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
