{
  "name": "ccdeck",
  "version": "3.39.0",
  "description": "Local dashboard for Claude Code and Codex CLI sessions: which Claude Code session needs input, every tool call and Claude Code subagent live, token cost and quota, several Claude accounts. Run npx ccdeck.",
  "type": "module",
  "bin": {
    "ccdeck": "bin/agent-dag.js"
  },
  "files": [
    "bin",
    "hook",
    "src/server",
    "dist/web",
    "release-notes.json",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSING.md"
  ],
  "scripts": {
    "dev:web": "vite",
    "dev:server": "node src/server/index.mjs",
    "start": "node bin/agent-dag.js",
    "build": "node scripts/build-radar-codec.mjs && vite build",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude-code-dashboard",
    "claude",
    "anthropic",
    "codex",
    "codex-cli",
    "openai",
    "agents",
    "ai-agents",
    "subagents",
    "dashboard",
    "monitor",
    "monitoring",
    "cost",
    "quota",
    "hooks",
    "dag",
    "visualization",
    "claude-code-monitor",
    "claude-code-sessions",
    "session-monitor",
    "codex-dashboard",
    "claude-code-subagents",
    "parallel-sessions",
    "desktop-app",
    "ccusage",
    "claude-swap",
    "local-first"
  ],
  "author": "Bargan Constantin",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarganConstantin/ccdeck.git"
  },
  "bugs": {
    "url": "https://github.com/BarganConstantin/ccdeck/issues"
  },
  "homepage": "https://ccdeck.dev",
  "devDependencies": {
    "@types/dagre": "^0.7.54",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "dagre": "^0.8.5",
    "esbuild": "0.25.12",
    "hls.js": "^1.7.3",
    "hpack.js": "2.1.6",
    "long": "5.3.2",
    "protobufjs": "8.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
