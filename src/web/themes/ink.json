    "shadow-1": "0 3px 12px rgba(37,43,50,0.07)",
    "shadow-2": "0 10px 28px rgba(37,43,50,0.12)",
    "shadow-contact": "0 1px 2px rgba(37,43,50,0.08)",
    "burst-live-wash": "#7048940a",
    "hero-core": "var(--accent)",
    "grid-line": "#dcded7",
    "minimap-mask": "rgba(241,240,235,0.85)",
    "cat-file": "#355974",
    "cat-shell": "#80552b",
    "cat-web": "#375e68",
    "cat-agent": "#765367",
    "cat-task": "#4d623f",
    "cat-plan": "#5b527c",
    "cat-mcp": "#3f625c",
    "cat-other": "#5e6468",
    "usage-purple": "#5b527c",
    "usage-blue": "#355974",
    "usage-teal": "#375e68",
    "usage-lime": "#575f37",
    "usage-pink": "#82596d",
    "usage-indigo": "#474f83",
    "usage-orange": "#754b32",
    "usage-zinc": "#5e6468",
    "usage-cyan": "#3f606c"
