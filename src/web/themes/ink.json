{
  "$schema": "./schema.json",
  "schemaVersion": 1,
  "id": "ink",
  "name": "Ink",
  "colorScheme": "light",
  "order": 130,
  "extends": "light",
  "tokens": {
    "bg": "#f1f0eb",
    "bg-soft": "#faf9f6",
    "panel": "#faf9f6",
    "line": "#caccc6",
    "line-soft": "#dfe0da",
    "text": "#252b32",
    "text-secondary": "#41474c",
    "muted": "#5e6468",
    "text-dim": "#62686b",
    "muted-dim": "#929794",
    "accent": "#364b5d",
    "accent-dim": "#364b5d1a",
    "ctl-fill": "color-mix(in srgb, var(--text) 5%, transparent)",
    "ctl-edge": "#7a7e7d",
    "sm-fill": "color-mix(in srgb, var(--text) 4%, transparent)",
    "sm-edge": "#7a7e7d",
    "chrome-bg": "#faf9f6",
    "chrome-edge": "#858b89",
    "ok": "#296341",
    "warn": "#87521a",
    "err": "#a43133",
    "inflight": "#704894",
