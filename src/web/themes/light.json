{
  "$schema": "./schema.json",
  "schemaVersion": 1,
  "id": "light",
  "name": "Light",
  "colorScheme": "light",
  "order": 10,
  "extends": "dark",
  "tokens": {
    "bg": "#eef1f6",
    "bg-soft": "#ffffff",
    "panel": "#ffffff",
    "line": "#c8cdd6",
    "line-soft": "#dde1e8",
    "text": "#0d1117",
    "text-secondary": "#303845",
    "muted": "#4a5260",
    "muted-dim": "#7c8493",
    "text-dim": "#5f6673",
    "ctl-fill": "color-mix(in srgb, var(--text) 7%, transparent)",
    "ctl-edge": "color-mix(in srgb, var(--text) 50%, transparent)",
    "chrome-bg": "color-mix(in srgb, var(--panel) 60%, var(--bg))",
    "chrome-edge": "color-mix(in srgb, var(--line) 60%, var(--bg))",
    "sm-edge": "color-mix(in srgb, var(--text) 46%, transparent)",
    "sm-fill": "color-mix(in srgb, var(--text) 5%, transparent)",
    "accent": "#0369a1",
    "accent-dim": "rgba(3,105,161,0.22)",
    "ok": "#157a3a",
    "warn": "#ad4e08",
    "err": "#b91c1c",
    "inflight": "#7e22ce",
    "shadow-1": "0 4px 14px rgba(15,23,42,0.10)",
    "shadow-2": "0 10px 28px rgba(15,23,42,0.16)",
    "shadow-contact": "0 1px 2px rgba(15,23,42,0.10)",
    "node-grad": "linear-gradient(180deg, #ffffff, #f2f5fa)",
    "topbar-grad": "linear-gradient(to bottom, #ffffff, #eef1f6)",
    "conn-wash": "linear-gradient(90deg, rgba(185,28,28,0.14), transparent)",
    "burst-live-wash": "linear-gradient(180deg, rgba(126,34,206,0.06), transparent)",
    "hero-core": "radial-gradient(circle at 30% 30%, #a78bfa, #0ea5e9 55%, #1e293b)",
    "live-bloom": "color-mix(in srgb, var(--ok) 12%, transparent)",
    "glint": "var(--accent)",
    "grid-line": "#d0d5dd",
    "minimap-mask": "rgba(238,241,246,0.85)",
    "session-label-l": "26%",
    "session-accent-l": "26%",
    "session-rim-l": "38%",
    "session-edge-l": "30%",
    "session-edge-idle-l": "36%",
    "mcp-dot-l": "32%",
    "cat-file": "#0369a1",
    "cat-shell": "#b45309",
    "cat-web": "#0e7490",
    "cat-agent": "#a21caf",
    "cat-task": "#15803d",
    "cat-plan": "#4c1d95",
    "cat-mcp": "#0f766e",
    "cat-other": "#64748b",
    "usage-purple": "#4c1d95",
    "usage-blue": "#0369a1",
    "usage-teal": "#0f766e",
    "usage-lime": "#4d7c0f",
    "usage-pink": "#be185d",
    "usage-indigo": "#3730a3",
    "usage-orange": "#7c2d12",
    "usage-zinc": "#4a5260",
    "usage-cyan": "#0e7490"
  }
}
