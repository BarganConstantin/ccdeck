{
  "$schema": "./schema.json",
  "schemaVersion": 1,
  "id": "dark",
  "name": "Dark",
  "colorScheme": "dark",
  "order": 20,
  "tokens": {
    "bg": "#0b0c10",
    "bg-soft": "#0f1116",
    "panel": "#14161b",
    "line": "#1f2229",
    "line-soft": "#1a1c22",
    "text": "#d8dae0",
    "pixel-metal-light": "#cbd5e1",
    "pixel-metal-shadow": "#64748b",
    "pixel-metal-edge": "#475569",
    "pixel-character-body": "#38bdf8",
    "text-secondary": "#9aa0ab",
    "ctl-fill": "color-mix(in srgb, var(--text) 7%, transparent)",
    "ctl-edge": "color-mix(in srgb, var(--text) 50%, transparent)",
    "chrome-bg": "color-mix(in srgb, var(--panel) 60%, var(--bg))",
    "chrome-edge": "color-mix(in srgb, var(--line) 60%, var(--bg))",
    "sm-edge": "color-mix(in srgb, var(--text) 36%, transparent)",
    "sm-fill": "color-mix(in srgb, var(--text) 5%, transparent)",
    "muted": "#7e828c",
    "muted-dim": "#50535b",
    "text-dim": "#7e828c",
    "accent": "#7dd3fc",
    "accent-dim": "#38bdf850",
    "ok": "#86efac",
    "warn": "#fcd34d",
    "err": "#fca5a5",
    "inflight": "#f0abfc",
    "shadow-1": "0 6px 18px rgba(0,0,0,0.25)",
    "shadow-2": "0 10px 24px rgba(0,0,0,0.32)",
    "shadow-contact": "0 1px 2px rgba(0,0,0,0.30)",
    "node-grad": "linear-gradient(180deg, var(--panel), var(--bg-soft))",
    "topbar-grad": "linear-gradient(to bottom, var(--panel), var(--bg-soft))",
    "conn-wash": "linear-gradient(90deg, rgba(252,165,165,0.12), transparent)",
    "burst-live-wash": "linear-gradient(180deg, rgba(240,171,252,0.10), rgba(125,211,252,0.05))",
    "hero-core": "radial-gradient(circle at 30% 30%, #c4b5fd, #7dd3fc 55%, #14161b)",
    "live-bloom": "color-mix(in srgb, var(--ok) 24%, transparent)",
    "glint": "var(--text)",
    "grid-line": "#1a1d24",
    "minimap-mask": "rgba(11,12,16,0.85)",
    "session-label-l": "78%",
    "session-accent-l": "60%",
    "session-rim-l": "55%",
    "session-edge-l": "72%",
    "session-edge-idle-l": "55%",
    "mcp-dot-l": "65%",
    "cat-file": "#7dd3fc",
    "cat-shell": "#fcd34d",
    "cat-web": "#67e8f9",
    "cat-agent": "#f9a8d4",
    "cat-task": "#86efac",
    "cat-plan": "#c4b5fd",
    "cat-mcp": "#5eead4",
    "cat-other": "#94a3b8",
    "usage-purple": "#c4b5fd",
    "usage-blue": "#7dd3fc",
    "usage-teal": "#5eead4",
    "usage-lime": "#bef264",
    "usage-pink": "#f9a8d4",
    "usage-indigo": "#a5b4fc",
    "usage-orange": "#fdba74",
    "usage-zinc": "#94a3b8",
    "usage-cyan": "#67e8f9"
  }
}
