{
  "$schema": "./schema.json",
  "schemaVersion": 1,
  "id": "vscode-black",
  "name": "VS Code Black",
  "colorScheme": "dark",
  "order": 40,
  "extends": "dark",
  "tokens": {
    "bg": "#1f1f1f",
    "bg-soft": "#202020",
    "panel": "#181818",
    "line": "#2b2b2b",
    "line-soft": "#252526",
    "text": "#cccccc",
    "text-secondary": "#adadad",
    "muted": "#9d9d9d",
    "text-dim": "#9d9d9d",
    "muted-dim": "#616161",
    "accent": "#4daafc",
    "accent-dim": "#0078d450",
    "ok": "#89d185",
    "warn": "#e2c08d",
    "err": "#f48771",
    "chrome-bg": "#181818",
    "chrome-edge": "#3c3c3c",
    "node-grad": "var(--panel)",
    "topbar-grad": "var(--panel)",
    "conn-wash": "#f4877118",
    "burst-live-wash": "#f0abfc12",
    "hero-core": "#4daafc",
    "grid-line": "#2b2b2b",
    "minimap-mask": "rgba(31, 31, 31, .85)",
    "session-accent-l": "70%",
    "session-edge-idle-l": "60%"
  },
  "selection": {
    "background": "#264f78",
    "foreground": "#ffffff"
  }
}
